# Quick local/LAN evaluation defaults. Run ./scripts/docker-deploy.sh init to
# create .env.docker with generated secrets. Before an Internet deployment,
# switch CAMPUSOS_ENV to production, configure SMTP and terminate TLS.
CAMPUSOS_ENV=development
CAMPUSOS_IMAGE_TAG=0.13.0
DOCKER_BUILD_GOPROXY=https://goproxy.cn|https://proxy.golang.org|direct
DOCKER_BUILD_GOSUMDB=sum.golang.google.cn

HTTP_BIND=0.0.0.0
API_BIND=127.0.0.1
WEB_PORT=3000
ADMIN_PORT=3001
DOCS_PORT=3002
API_PORT=8080
PGADMIN_PORT=5050

POSTGRES_DB=campusos
POSTGRES_USER=campusos
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
REDIS_PASSWORD=

JWT_SECRET=__JWT_SECRET__
AUTH_BOOTSTRAP_ADMIN_SECRET=__BOOTSTRAP_ADMIN_SECRET__
AUTH_ALLOW_DEVELOPMENT_DEFAULT_ADMIN=false
AUTH_CHALLENGE_ACTIVE_KEY_ID=docker-v1
AUTH_CHALLENGE_HMAC_KEYS=docker-v1:__CHALLENGE_HMAC_SECRET__
AUTH_CHALLENGE_IP_HASH_SECRET=__CHALLENGE_IP_HASH_SECRET__
AUTH_SESSION_IP_HASH_SECRET=__SESSION_IP_HASH_SECRET__
AUTH_MFA_ACTIVE_KEY_ID=docker-v1
AUTH_MFA_ENCRYPTION_KEYS=docker-v1:__MFA_ENCRYPTION_SECRET__
AUTH_MFA_ISSUER=CampusOS

EMAIL_PROVIDER=fake
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_TIMEOUT=10s
EMAIL_SMTP_STARTTLS=true

AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT=30s
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENT=4

WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# Leave blank to derive companion links from the current browser host and the
# default 3000/3002 ports. Set full public URLs when using custom ports/domains.
PUBLIC_WEB_URL=
PUBLIC_DOCS_URL=
PUBLIC_GITHUB_URL=https://github.com/javencpdd/CampusOS
