# API-specific overrides. Security keys, database password, SMTP and third-party
# secrets remain in the shared .env.docker.
CAMPUSOS_BACKEND_NETWORK=campusos_backend
CAMPUSOS_EDGE_NETWORK=campusos_edge
CAMPUSOS_DATA_VOLUME=campusos_campusos-data
API_BIND=127.0.0.1
API_PORT=8080

# Optional v5 UI: all three UI variables required, otherwise leave blank.
# Trust store is an operator-provided public-key file visible in the container.
CAMPUSOS_PLUGIN_V5_TRUST_STORE=
CAMPUSOS_PLUGIN_UI_LISTEN=
CAMPUSOS_PLUGIN_UI_ORIGIN=
CAMPUSOS_PLUGIN_UI_PARENTS=
