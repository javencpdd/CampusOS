# Non-secret infrastructure overrides. POSTGRES_PASSWORD remains in the shared
# .env.docker so API and PostgreSQL cannot drift.
CAMPUSOS_BACKEND_NETWORK=campusos_backend
CAMPUSOS_POSTGRES_VOLUME=campusos_postgres-data
CAMPUSOS_REDIS_VOLUME=campusos_redis-data
CAMPUSOS_NATS_VOLUME=campusos_nats-data
POSTGRES_DB=campusos
POSTGRES_USER=campusos
