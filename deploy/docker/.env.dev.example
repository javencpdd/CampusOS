# CampusOS Docker 开发环境配置模板（Windows Docker Desktop / Linux 通用）。
# 更新时间：2026-10-27（Asia/Shanghai）。实际配置请修改被 Git 忽略的 .env.dev.local。
# 仅修改注释不必重启；修改配置值后，在仓库根目录执行 docker-dev.ps1 up 或 docker-dev.sh up。
# up 会重新应用容器环境；单独 docker restart 不会重读本文件，也不必因此 rebuild。
# 密码、初始化凭证和加密密钥不要提交到 Git；不要把真实值贴到终端日志或聊天中。

# 一、网络绑定与宿主机端口
# API、PostgreSQL、Redis、NATS 和可选 pgAdmin 的宿主机绑定；必须保持回环，禁止改为 0.0.0.0。
CAMPUSOS_DEV_BIND=127.0.0.1
# 是否明确允许 UI 暴露到可信局域网；true 仍须配合下方各 UI 绑定及限定子网防火墙。
CAMPUSOS_DEV_ALLOW_LAN=false
# 用户端绑定：127.0.0.1 仅本机；可信局域网访问时可设 0.0.0.0。
CAMPUSOS_DEV_WEB_BIND=127.0.0.1
# 管理端绑定：127.0.0.1 仅本机；按需设 0.0.0.0，不代表开放管理权限。
CAMPUSOS_DEV_ADMIN_BIND=127.0.0.1
# 文档站绑定：127.0.0.1 仅本机；按需设 0.0.0.0。
CAMPUSOS_DEV_DOCS_BIND=127.0.0.1
# 独立插件 UI 网关绑定；局域网 PDF 预览也需要此端口可达，API/数据端口仍保持回环。
CAMPUSOS_DEV_PLUGIN_UI_BIND=127.0.0.1
# 用户端宿主机端口；默认访问 http://localhost:3000。
CAMPUSOS_DEV_WEB_PORT=3000
# 管理端宿主机端口；默认访问 http://localhost:3001。
CAMPUSOS_DEV_ADMIN_PORT=3001
# 文档站宿主机端口；默认访问 http://localhost:3002。
CAMPUSOS_DEV_DOCS_PORT=3002
# 插件 UI 独立跨域网关的宿主机端口；不同于 API 8080，也不是新增的用户登录入口。
CAMPUSOS_DEV_PLUGIN_UI_PORT=3003
# 插件 UI 对外 Origin 的协议；默认开发 HTTP，不能只改成 https 而不配置对应 TLS 终止。
CAMPUSOS_PLUGIN_UI_SCHEME=http
# 插件隔离子域的基础域名；实际使用 {isolation}.域名，必须能从浏览器解析到开发机。
# 本机默认 localhost；局域网须设置支持通配子域的开发域名，不能填写容器名 api。
CAMPUSOS_PLUGIN_UI_DOMAIN=localhost
# 允许嵌入插件 UI 的精确父页面 Origin，以空格分隔；协议、域名/IP、端口均须匹配。
# 改 UI 端口或使用局域网 IP 时同步加入对应 3000/3001 Origin；不使用通配符。
CAMPUSOS_PLUGIN_UI_PARENTS="http://localhost:3000 http://localhost:3001"
# v5 插件发布者公钥信任文件的容器内路径；留空表示没有受信发布者，不会自动信任插件。
# 例如 /workspace/.campusos/plugin-v5-trust.json；这里只放受信公钥信息，绝不填写签名私钥。
CAMPUSOS_PLUGIN_V5_TRUST_STORE=
# API 的本机映射端口；初始化示例使用 8080，修改后须同步调整本机请求地址。
CAMPUSOS_DEV_API_PORT=8080
# PostgreSQL 的本机映射端口；仅宿主机工具使用，容器间仍通过 postgres:5432 通信。
CAMPUSOS_DEV_POSTGRES_PORT=55432
# Redis 的本机映射端口；容器间仍通过 redis:6379 通信。
CAMPUSOS_DEV_REDIS_PORT=56379
# NATS 客户端连接的本机映射端口；容器间仍通过 nats:4222 通信。
CAMPUSOS_DEV_NATS_PORT=54222
# NATS 监控 HTTP 的本机映射端口；不是用户站点，不向局域网开放。
CAMPUSOS_DEV_NATS_MONITOR_PORT=58222
# 可选 pgAdmin 的本机端口；只有启用对应 Compose profile 时才会启动该服务。
CAMPUSOS_DEV_PGADMIN_PORT=5050
# Docker 对 API 容器的健康探测间隔；使用 5s、30s、1m 等 Compose 时长格式。
# 这不是浏览器/管理端 /api/v1/health 的轮询间隔，也不是源码热更新间隔。
CAMPUSOS_DEV_API_HEALTHCHECK_INTERVAL=5s
# API 源码变化轮询间隔，单位秒（供容器 sleep 使用）；只影响 Go 开发热更新检测。
CAMPUSOS_DEV_POLL_INTERVAL=1
# 容器写入开发文件时使用的 UID；Bash 启动器默认取当前 Linux/WSL 用户，PowerShell 默认 1000。
CAMPUSOS_DEV_UID=1000
# 对应 GID；作用于容器文件权限，不是 CampusOS 用户 ID 或用户组角色。
CAMPUSOS_DEV_GID=1000

# 二、开发数据服务
# PostgreSQL 初次初始化的数据库名；已有数据卷不会因改此项而自动重建数据库。
POSTGRES_DB=campusos
# PostgreSQL 初次初始化的数据库账号；不是前台用户或管理端账号。
POSTGRES_USER=campusos
# PostgreSQL 密码；示例值仅供本机开发，已有数据卷的密码不会随 env 修改自动更新。
# 不要为使配置生效而删除数据卷；需由数据库管理员显式修改已有数据库凭据。
POSTGRES_PASSWORD=campusos_dev
# Redis 认证密码；空表示此开发 Redis 不启用密码，仅限回环/容器网络使用。
REDIS_PASSWORD=

# 三、身份认证与管理员初始化
# 原生 make dev-all 连接同一开发数据服务时会复用这些身份配置；不要随意换钥损坏现有记录。
# 运行环境：development、test、staging 或 production；本模板仅适用于 development。
CAMPUSOS_ENV=development
# 当前只支持 single 单实例；此配置不会提供多写入者、高可用或分布式文件存储。
CAMPUSOS_INSTANCE_MODE=single
# 用户域 JWT 签名密钥；当前管理域默认由它派生隔离密钥，不是任何账号的登录密码。
# 共享环境请替换开发默认值；更换会影响现有 Token 验证，须按换钥/会话策略操作。
JWT_SECRET=campusos-dev-secret-key-change-in-production
# 访问 Token 有效时长，支持 15m 等 Go duration 格式；当前管理域也复用该时长。
JWT_ACCESS_TTL=15m
# 刷新会话有效时长，默认 720h（30 天）；不是“记住登录密码”的保存时间。
JWT_REFRESH_TTL=720h
# 用户域 JWT issuer 标识；管理域使用固定的独立 issuer/audience，不通过此项变成用户域。
JWT_ISSUER=campusos
# 是否对新密码使用哈希；应保持 true，非 development 环境禁止关闭。
AUTH_PASSWORD_HASH_ENABLED=true
# 旧用户域兼容引导/本地恢复凭据；不会创建 3001 独立管理域账号，也不是该域登录密码。
# 非空时可能用于旧 users/accounts 的首次引导；修改它不会重置已有账号的非默认密码。
AUTH_BOOTSTRAP_ADMIN_SECRET=
# 独立管理域“首次创建安全管理员”的一次性请求证明；留空关闭初始化入口。
# 非空时必须为 16–4096 字节且不同于上项，建议使用至少 32 个随机字节；不是登录密码。
# username、email、password 在 bootstrap 请求中设置；请求头为 X-CampusOS-Bootstrap-Secret。
# 首次创建成功后清空此项并执行 up；已有有效安全管理员时不能再次初始化或重置密码。
AUTH_ADMIN_BOOTSTRAP_SECRET=
# 独立管理端敏感操作是否要求 MFA：默认 true；显式 false 后仅用密码认证与原有权限校验。
# 关闭会降低账号安全性，生产/局域网建议保持 true；不会删除认证器绑定或伪装为已通过 MFA。
# 修改后执行 up；开启时管理端提供认证器配置、六位验证码及验证时效引导。
AUTH_ADMIN_MFA_REQUIRED=true
# 是否允许 development 的旧用户域默认账号兼容引导；不创建 admin_accounts，不能登录独立管理端。
# 仅本机开发可按需启用；生产禁止 true，不能用此项代替上面的管理域首次初始化。
AUTH_ALLOW_DEVELOPMENT_DEFAULT_ADMIN=true
# 验证码/挑战票据当前使用的 HMAC 密钥 ID，必须存在于下方密钥列表。
AUTH_CHALLENGE_ACTIVE_KEY_ID=development-v1
# 挑战票据 HMAC 密钥列表：密钥ID:密钥,密钥ID:密钥；共享环境替换开发默认值并妥善保管。
AUTH_CHALLENGE_HMAC_KEYS=development-v1:campusos-development-challenge-key-change-before-production
# 挑战流程中 IP 脱敏哈希的专用密钥；不是 SMTP、登录或初始化密码。
AUTH_CHALLENGE_IP_HASH_SECRET=campusos-development-ip-hash-key-change-before-production
# 会话 IP 脱敏哈希的专用密钥；共享环境替换默认值，避免与其他用途密钥混用。
AUTH_SESSION_IP_HASH_SECRET=campusos-development-session-ip-hash-key-change-before-production
# 是否接受旧刷新 Token 请求正文兼容格式；默认 false，浏览器使用现行 Cookie/CSRF 流程。
AUTH_REFRESH_BODY_COMPAT=false
# MFA 敏感资料加密的当前密钥 ID，必须存在于下方密钥列表；不是用户输入的动态验证码。
AUTH_MFA_ACTIVE_KEY_ID=development-v1
# MFA 加密密钥列表：密钥ID:密钥,密钥ID:密钥；旧记录仍引用旧 ID 时不能直接删除对应密钥。
AUTH_MFA_ENCRYPTION_KEYS=development-v1:campusos-development-mfa-encryption-key-change-before-production
# MFA 验证器中显示的发行方名称，例如 CampusOS；不是登录用户名或管理员邮箱。
AUTH_MFA_ISSUER=CampusOS

# 四、插件 Secret 加密与换钥
# 未配置下方共享 Keyring 时使用的开发插件 Secret 加密密钥；32 字节密钥的 hex/base64 表示。
# 不是插件密码/授权 Token；共享环境必须替换默认值，旧密文/备份仍需原密钥解密。
CAMPUSOS_PLUGIN_SECRET_KEY=63616d7075736f732d6465762d706c7567696e2d7365637265742d6b65792121
# 上项密钥的版本 ID，记录在密文元数据中；只改名字并不等于完成密钥轮换。
CAMPUSOS_PLUGIN_SECRET_KEY_VERSION=development-v1

# 可选共享 Secret Keyring 的当前写入密钥 ID；须与下项同时设置，且 ID 必须存在于列表。
CAMPUSOS_SECRET_ACTIVE_KEY_ID=
# Keyring 格式：密钥ID:64位hex或32字节base64,密钥ID:密钥；这里填写加密密钥，不是插件业务 Secret。
# 换钥时保留仍被当前密文、历史记录或备份引用的旧 key，不能只保留新写入 key。
CAMPUSOS_SECRET_ENCRYPTION_KEYS=

# 是否启用带操作审计的后台插件 Secret 重加密；需 PostgreSQL、有效 Keyring 和全部旧读取密钥。
# 开启只处理支持的活动 Secret，不代表历史/备份已全部换钥，不能据此删除旧 key。
CAMPUSOS_SECRET_ROTATION_ENABLED=false
# 后台换钥扫描间隔，Go duration 格式；启用时允许 1s–24h，默认 5m。
CAMPUSOS_SECRET_ROTATION_INTERVAL=5m

# 五、邮件投递（注册、密码重置、邮箱绑定等挑战流程）
# fake 只模拟投递成功，不发送邮件、不输出验证码；需要真实邮件时选择 smtp 并填写下方字段。
EMAIL_PROVIDER=fake
# SMTP 服务器主机名，例如 smtp.qq.com；不要填写 https:// 前缀或邮件网页地址。
EMAIL_SMTP_HOST=
# SMTP 服务端口；当前 STARTTLS 示例为 587，按服务商要求配置，不能把 465 隐式 TLS 当作 STARTTLS。
EMAIL_SMTP_PORT=587
# SMTP 登录账号，通常为完整邮箱；与管理端账号完全无关。
EMAIL_SMTP_USERNAME=
# SMTP 认证密码；QQ/部分邮箱须填写服务商生成的 SMTP 授权码，而非邮箱网页登录密码。
EMAIL_SMTP_PASSWORD=
# 发件人邮箱（From），须符合 SMTP 服务商要求并有相应发信授权；不是管理端登录邮箱。
EMAIL_SMTP_FROM=
# 单次 SMTP 投递超时，支持 10s 等 Go duration 格式；不是验证码有效期。
EMAIL_SMTP_TIMEOUT=10s
# 是否使用 STARTTLS 升级连接；按邮件服务商要求配置，不建议在不可信网络关闭加密。
EMAIL_SMTP_STARTTLS=true

# 六、Go 依赖下载（不等于 Docker Hub 或系统代理）
# 构建/API 开发容器的 Go 模块代理链；竖线表示出错时尝试下一项，不配置 Docker 镜像仓库代理。
DOCKER_BUILD_GOPROXY=https://goproxy.cn|https://proxy.golang.org|direct
# Go 模块校验数据库；不要为绕过网络问题关闭依赖校验，Docker Hub 连接仍需单独排查。
DOCKER_BUILD_GOSUMDB=sum.golang.google.cn
