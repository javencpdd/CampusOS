# Canonical repository text is UTF-8/LF. Git stores normalized LF blobs and
# checks text out as LF on Windows, Linux and inside containers.
* text=auto eol=lf

# Linux/container entrypoints and configuration must never acquire CRLF.
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-native command scripts keep their conventional checkout format.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Resource checksums are calculated from working-tree bytes. Keep every text
# payload stable across Windows and Linux; binary rules below take precedence.
data/resources/** text eol=lf
data/module_data/** text eol=lf
data/plugin_data/** text eol=lf

# Binary artifacts must never be newline-normalized.
main -text
