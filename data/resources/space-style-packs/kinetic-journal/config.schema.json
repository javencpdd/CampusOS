{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "motion_density": {
      "type": "number",
      "minimum": 6,
      "maximum": 24,
      "default": 12
    },
    "accent_mode": {
      "type": "string",
      "enum": ["lime", "coral", "blue"],
      "default": "lime"
    }
  }
}
