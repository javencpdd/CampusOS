{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campusos.local/schemas/plugin-v5-release-v1.schema.json",
  "title": "CampusOS v5 immutable release envelope (G1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["publisher", "key", "version", "package_digest", "signature"],
  "properties": {
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "package_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "value"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}
