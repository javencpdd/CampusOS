{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campusos.local/schemas/plugin-v5-extension-catalog-v1.schema.json",
  "title": "Host-owned v5 extension point catalog snapshot (G1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "host_contract", "points"],
  "properties": {
    "contract": { "const": "campusos.extension-catalog/v1" },
    "host_contract": { "type": "string", "pattern": "^campusos\\.host/v[1-9][0-9]*$" },
    "points": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["point", "contract_version", "input_schema", "output_schema", "capabilities", "data_modes"],
        "properties": {
          "point": { "enum": ["preview.renderer", "ai.chat", "knowledge.source"] },
          "contract_version": { "const": "v1" },
          "input_schema": { "type": "string", "pattern": "^campusos\\.[a-z.]+\\.request/v1$" },
          "output_schema": { "type": "string", "pattern": "^campusos\\.[a-z.]+\\.response/v1$" },
          "capabilities": {
            "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
          },
          "data_modes": {
            "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
            "items": { "enum": ["authorized_resource", "public_only", "no_host_private_data"] }
          }
        }
      }
    }
  }
}
