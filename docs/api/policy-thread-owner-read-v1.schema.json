{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:campusos:policy:thread-owner-read:v1",
  "title": "CampusOS thread owner-read policy contract; internal host DTO only",
  "oneOf": [
    {
      "$ref": "#/definitions/request"
    },
    {
      "$ref": "#/definitions/decision"
    }
  ],
  "definitions": {
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "community.thread"
        },
        "id": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "community.board"
        },
        "id": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "owner",
        "board",
        "facts_version",
        "publication_status",
        "moderation_status",
        "deletion_status"
      ],
      "properties": {
        "resource": {
          "$ref": "#/definitions/thread"
        },
        "owner": {
          "$ref": "urn:campusos:principal:v1#/definitions/user"
        },
        "board": {
          "$ref": "#/definitions/board"
        },
        "facts_version": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        },
        "publication_status": {
          "enum": [
            "draft",
            "published",
            "private"
          ]
        },
        "moderation_status": {
          "enum": [
            "clear",
            "pending",
            "rejected",
            "taken_down"
          ]
        },
        "deletion_status": {
          "enum": [
            "active",
            "trashed",
            "purged"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "request_id",
        "policy",
        "principal",
        "facts"
      ],
      "properties": {
        "contract": {
          "const": "campusos.policy.thread-owner-read/v1"
        },
        "request_id": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        },
        "policy": {
          "const": "community.thread.owner_read/v1"
        },
        "principal": {
          "$ref": "urn:campusos:principal:v1"
        },
        "facts": {
          "$ref": "#/definitions/facts"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "request_id",
        "policy",
        "principal",
        "resource",
        "facts_version",
        "effect",
        "reason",
        "obligations"
      ],
      "properties": {
        "contract": {
          "const": "campusos.policy.thread-owner-read/v1"
        },
        "request_id": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        },
        "policy": {
          "const": "community.thread.owner_read/v1"
        },
        "resource": {
          "$ref": "#/definitions/thread"
        },
        "facts_version": {
          "$ref": "urn:campusos:principal:v1#/definitions/opaqueID"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reason": {
          "enum": [
            "policy.owner_read",
            "policy.owner_read_denied"
          ]
        },
        "obligations": {
          "type": "array"
        },
        "principal": {
          "$ref": "urn:campusos:principal:v1"
        }
      },
      "oneOf": [
        {
          "properties": {
            "effect": {
              "const": "allow"
            },
            "reason": {
              "const": "policy.owner_read"
            },
            "obligations": {
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "const": "recheck_current_facts"
              }
            }
          }
        },
        {
          "properties": {
            "effect": {
              "const": "deny"
            },
            "reason": {
              "const": "policy.owner_read_denied"
            },
            "obligations": {
              "maxItems": 0
            }
          }
        }
      ]
    }
  }
}
