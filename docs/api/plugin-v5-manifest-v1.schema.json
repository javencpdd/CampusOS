{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campusos.local/schemas/plugin-v5-manifest-v1.schema.json",
  "title": "CampusOS complete v5 target Manifest (G1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "publisher",
    "key",
    "version",
    "host_contracts",
    "runtime",
    "provides",
    "consumes",
    "configuration",
    "data"
  ],
  "properties": {
    "api_version": {
      "const": "campusos.plugin/v5"
    },
    "publisher": {
      "$ref": "#/definitions/name"
    },
    "key": {
      "$ref": "#/definitions/name"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "host_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^campusos\\.host/v[1-9][0-9]*$"
      }
    },
    "runtime": {
      "enum": [
        "none",
        "wasm",
        "container"
      ]
    },
    "ui": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/ui"
      }
    },
    "backend": {
      "$ref": "#/definitions/backend"
    },
    "provides": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "point",
          "contract_version",
          "input_schema",
          "output_schema",
          "capabilities",
          "data_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
          },
          "point": {
            "enum": [
              "preview.renderer",
              "ai.chat",
              "knowledge.source"
            ]
          },
          "contract_version": {
            "const": "v1"
          },
          "input_schema": {
            "type": "string",
            "pattern": "^campusos\\.[a-z.]+\\.request/v1$"
          },
          "output_schema": {
            "type": "string",
            "pattern": "^campusos\\.[a-z.]+\\.response/v1$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            }
          },
          "data_mode": {
            "enum": [
              "authorized_resource",
              "public_only",
              "no_host_private_data"
            ]
          },
          "config_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+\\.json$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "consumes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "scope",
          "purpose",
          "required"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{2,127}$"
          },
          "scope": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "public"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "self"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "collection_ids"
                ],
                "properties": {
                  "kind": {
                    "const": "collection"
                  },
                  "collection_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "keys"
                ],
                "properties": {
                  "kind": {
                    "const": "system_config"
                  },
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                    }
                  }
                }
              }
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "host_resources": {
      "$ref": "#/definitions/resources"
    },
    "configuration": {
      "$ref": "#/definitions/config_definition"
    },
    "data": {
      "$ref": "#/definitions/data"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "none"
          }
        }
      },
      "then": {
        "required": [
          "ui"
        ],
        "not": {
          "required": [
            "backend"
          ]
        }
      },
      "else": {
        "required": [
          "backend"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "none"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "host_resources"
          ]
        }
      },
      "else": {
        "required": [
          "host_resources"
        ]
      }
    }
  ],
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+$"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "entrypoint",
        "digest"
      ],
      "properties": {
        "audience": {
          "enum": [
            "user",
            "admin"
          ]
        },
        "entrypoint": {
          "$ref": "#/definitions/path"
        },
        "digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "transport"
      ],
      "properties": {
        "artifact": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "path",
                "digest"
              ],
              "properties": {
                "kind": {
                  "const": "wasm"
                },
                "path": {
                  "$ref": "#/definitions/path"
                },
                "digest": {
                  "$ref": "#/definitions/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "image"
              ],
              "properties": {
                "kind": {
                  "const": "container"
                },
                "image": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._:/-]+@sha256:[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "transport": {
          "enum": [
            "host-call",
            "http",
            "grpc"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "point",
        "contract_version"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/name"
        },
        "point": {
          "enum": [
            "preview.renderer",
            "ai.chat",
            "knowledge.source"
          ]
        },
        "contract_version": {
          "const": "v1"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_targets",
        "storage_bytes",
        "cpu_millis",
        "memory_mb",
        "max_concurrency",
        "timeout_ms"
      ],
      "properties": {
        "network_targets": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 253
          }
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10737418240
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    },
    "config_field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      },
      "required": [
        "type",
        "title"
      ]
    },
    "config_schema_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "patternProperties": {
            "^[a-z][a-z0-9_.-]{0,63}$": {
              "$ref": "#/definitions/config_field"
            }
          },
          "additionalProperties": false
        },
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        }
      },
      "required": [
        "type",
        "additionalProperties",
        "properties",
        "required"
      ]
    },
    "config_definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "campusos.plugin-config/v1"
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "schema": {
          "$ref": "#/definitions/config_schema_spec"
        },
        "defaults": {
          "type": "object",
          "maxProperties": 32
        },
        "selectors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "kind": {
                "enum": [
                  "profile",
                  "public_collection"
                ]
              }
            },
            "required": [
              "field",
              "kind"
            ]
          }
        },
        "secret_names": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        }
      },
      "required": [
        "contract",
        "version",
        "schema",
        "defaults",
        "selectors",
        "secret_names"
      ]
    },
    "config_update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "object",
          "maxProperties": 32
        },
        "secret_refs": {
          "type": "object",
          "maxProperties": 32,
          "patternProperties": {
            "^[a-z][a-z0-9_.-]{0,63}$": {
              "type": "string",
              "pattern": "^secret-ref:[a-z0-9-]{2,128}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "expected_revision",
        "values",
        "secret_refs"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_scope",
        "private_kv_bytes",
        "private_object_bytes",
        "upgrade"
      ],
      "properties": {
        "config_scope": {
          "enum": [
            "system",
            "user",
            "both"
          ]
        },
        "private_kv_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10737418240
        },
        "private_object_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10737418240
        },
        "upgrade": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "mode",
            "rollback"
          ],
          "properties": {
            "schema_version": {
              "type": "integer",
              "minimum": 1
            },
            "mode": {
              "enum": [
                "preserve",
                "migrate",
                "reset"
              ]
            },
            "rollback": {
              "enum": [
                "snapshot",
                "forbidden"
              ]
            }
          }
        }
      }
    }
  }
}
