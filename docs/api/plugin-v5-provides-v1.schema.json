{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://campusos.local/schemas/plugin-v5-provides-v1.schema.json",
  "title": "CampusOS v5 provides projection (G1)",
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "point", "contract_version", "input_schema", "output_schema", "capabilities", "data_mode"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
      "point": { "enum": ["preview.renderer", "ai.chat", "knowledge.source"] },
      "contract_version": { "const": "v1" },
      "input_schema": { "type": "string", "pattern": "^campusos\\.[a-z.]+\\.request/v1$" },
      "output_schema": { "type": "string", "pattern": "^campusos\\.[a-z.]+\\.response/v1$" },
      "capabilities": {
        "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" }
      },
      "data_mode": { "enum": ["authorized_resource", "public_only", "no_host_private_data"] },
      "config_schema": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+\\.json$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
