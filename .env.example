# CampusOS local development environment

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WEB_PORT=3000
ADMIN_PORT=3001
DOCS_PORT=3002
HOST_API_ENABLED=true
HOST_API_ADDR=127.0.0.1:18080

# Metrics collection is always enabled. The dedicated Prometheus listener is
# opt-in and must remain on an explicit loopback address.
OBSERVABILITY_PROMETHEUS_ENABLED=false
OBSERVABILITY_PROMETHEUS_ADDR=127.0.0.1:9091
OBSERVABILITY_PROMETHEUS_PATH=/metrics

DATABASE_DSN=postgres://campusos:campusos_dev@localhost:5432/campusos?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=campusos
DB_NAME=campusos
DB_PASSWORD=campusos_dev
MIGRATIONS_DIR=migrations
POSTGRES_PORT=5432

REDIS_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379

NATS_URL=nats://localhost:4222
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

PGADMIN_PORT=5050

JWT_SECRET=campusos-dev-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=campusos

# Deployment credentials. The compatibility default administrator is available
# only when CAMPUSOS_ENV=development and the explicit opt-in below is true.
# Production must provide a unique bootstrap secret and a non-default JWT key.
CAMPUSOS_ENV=development
AUTH_BOOTSTRAP_ADMIN_SECRET=
AUTH_ALLOW_DEVELOPMENT_DEFAULT_ADMIN=true

# Email verification challenge secrets. The example values are development-only
# sentinels. Production must use a rotated key id/secret pair and a distinct
# IP hashing secret injected by the deployment secret manager.
AUTH_CHALLENGE_ACTIVE_KEY_ID=development-v1
AUTH_CHALLENGE_HMAC_KEYS=development-v1:campusos-development-challenge-key-change-before-production
AUTH_CHALLENGE_IP_HASH_SECRET=campusos-development-ip-hash-key-change-before-production

# v12 server-side session state. Refresh tokens are opaque and kept in an
# HttpOnly cookie; this key is used only to hash request IP metadata. The JSON
# refresh body is disabled by default and exists only for a short migration
# window when an operator explicitly sets AUTH_REFRESH_BODY_COMPAT=true.
AUTH_SESSION_IP_HASH_SECRET=campusos-development-session-ip-hash-key-change-before-production
AUTH_REFRESH_BODY_COMPAT=false

# v13 TOTP MFA envelope key ring. Keep retired keys while existing MFA methods
# still reference them; never place this value in a frontend build, plugin
# manifest, resource package, export, or database row.
AUTH_MFA_ACTIVE_KEY_ID=development-v1
AUTH_MFA_ENCRYPTION_KEYS=development-v1:campusos-development-mfa-encryption-key-change-before-production
AUTH_MFA_ISSUER=CampusOS

# Core email delivery. fake is intentionally local/test only and never logs a
# verification code. Production must use smtp and inject credentials through a
# secret manager rather than this tracked file.
# EMAIL_PROVIDER=fake
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM=
# EMAIL_SMTP_TIMEOUT=10s
# EMAIL_SMTP_STARTTLS=true

EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=alive.jack@foxmail.com
EMAIL_SMTP_PASSWORD=lplxkjyznaosbgfg
EMAIL_SMTP_FROM=alive.jack@foxmail.com
EMAIL_SMTP_TIMEOUT=10s
EMAIL_SMTP_STARTTLS=true

# true: bcrypt password hash, recommended.
# false: plaintext password storage/login, local debugging only.
AUTH_PASSWORD_HASH_ENABLED=true

PLUGINS_DIR=data/plugins
PLUGIN_DATA_DIR=data/plugin_data
RESOURCE_DIR=data/resources
MODULE_DATA_DIR=data/module_data
# v0.9 local User Storage and legacy plugin SQLite KV are single-writer only.
CAMPUSOS_INSTANCE_MODE=single

# Admin external resource links
VITE_WEB_URL=http://localhost:3000
VITE_DOCS_URL=http://localhost:3002
VITE_GITHUB_URL=https://github.com/javencpdd/CampusOS

AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT=30s
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENT=4

# Webhook outbound egress is strict by default. Leave private-network access
# disabled outside explicitly isolated development tests.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
