digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — Storage", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_Storage {
    label="Storage"; color="#DFF5F2"; penwidth=2; style="rounded";
    n_storage_objects [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DFF5F2" COLSPAN="3"><B>storage_objects</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_owner_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_namespace" ALIGN="LEFT"><FONT POINT-SIZE="9">namespace</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_purpose" ALIGN="LEFT"><FONT POINT-SIZE="9">purpose</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_provider" ALIGN="LEFT"><FONT POINT-SIZE="9">provider</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_storage_key" ALIGN="LEFT"><FONT POINT-SIZE="9">storage_key</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_original_name" ALIGN="LEFT"><FONT POINT-SIZE="9">original_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_mime_type" ALIGN="LEFT"><FONT POINT-SIZE="9">mime_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_size_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">size_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sha256" ALIGN="LEFT"><FONT POINT-SIZE="9">sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="storage_objects"];
    n_user_storage_accounts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DFF5F2" COLSPAN="3"><B>user_storage_accounts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_used_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">used_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reserved_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">reserved_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_storage_accounts"];
    n_user_storage_quotas [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DFF5F2" COLSPAN="3"><B>user_storage_quotas</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_quota_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">quota_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_updated_by" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_storage_quotas"];
    n_user_storage_reservations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DFF5F2" COLSPAN="3"><B>user_storage_reservations</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ NN</FONT></TD><TD PORT="p_object_id" ALIGN="LEFT"><FONT POINT-SIZE="9">object_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reserved_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">reserved_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_expires_at" ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_storage_reservations"];
  }
}