  }
  subgraph cluster_external {
    label="External references"; color="#DDDDDD"; style="dashed,rounded";
    n_platform_outbox [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F7F7F7" COLSPAN="3"><B>platform_outbox</B></TD></TR></TABLE>>, tooltip="platform_outbox"];
    n_users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F7F7F7" COLSPAN="3"><B>users</B></TD></TR></TABLE>>, tooltip="users"];
  }
  n_users:p_id:e -> n_configurations:p_updated_by:w [dir=both, arrowtail=tee, arrowhead=crow, label="1 : N · DEL RESTRICT", tooltip="fk_configurations_updated_by: configurations(updated_by) → users(id)"];
