digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — Academic &amp; Schedule", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_Academic___Schedule {
    label="Academic &amp; Schedule"; color="#FFF0D8"; penwidth=2; style="rounded";
    n_academic_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFF0D8" COLSPAN="3"><B>academic_terms</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_year" ALIGN="LEFT"><FONT POINT-SIZE="9">year</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_semester" ALIGN="LEFT"><FONT POINT-SIZE="9">semester</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_first_week_start" ALIGN="LEFT"><FONT POINT-SIZE="9">first_week_start</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_is_default" ALIGN="LEFT"><FONT POINT-SIZE="9">is_default</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_created_by" ALIGN="LEFT"><FONT POINT-SIZE="9">created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_updated_by" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_closed_at" ALIGN="LEFT"><FONT POINT-SIZE="9">closed_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="academic_terms"];
    n_user_schedule_preferences [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFF0D8" COLSPAN="3"><B>user_schedule_preferences</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_academic_term_id" ALIGN="LEFT"><FONT POINT-SIZE="9">academic_term_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, tooltip="user_schedule_preferences"];
    n_user_schedule_terms [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFF0D8" COLSPAN="3"><B>user_schedule_terms</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK NN</FONT></TD><TD PORT="p_academic_term_id" ALIGN="LEFT"><FONT POINT-SIZE="9">academic_term_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, tooltip="user_schedule_terms"];
  }
}