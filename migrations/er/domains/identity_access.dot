digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — Identity &amp; Access", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_Identity___Access {
    label="Identity &amp; Access"; color="#DCEBFF"; penwidth=2; style="rounded";
    n_accounts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DCEBFF" COLSPAN="3"><B>accounts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_type" ALIGN="LEFT"><FONT POINT-SIZE="9">type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_identifier" ALIGN="LEFT"><FONT POINT-SIZE="9">identifier</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_credential" ALIGN="LEFT"><FONT POINT-SIZE="9">credential</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_verified" ALIGN="LEFT"><FONT POINT-SIZE="9">verified</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="accounts"];
    n_api_keys [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DCEBFF" COLSPAN="3"><B>api_keys</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_key" ALIGN="LEFT"><FONT POINT-SIZE="9">key</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_name" ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_plugin_name" ALIGN="LEFT"><FONT POINT-SIZE="9">plugin_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_permissions" ALIGN="LEFT"><FONT POINT-SIZE="9">permissions</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_is_active" ALIGN="LEFT"><FONT POINT-SIZE="9">is_active</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_last_used_at" ALIGN="LEFT"><FONT POINT-SIZE="9">last_used_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_expires_at" ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="api_keys"];
    n_authorization_audits [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DCEBFF" COLSPAN="3"><B>authorization_audits</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_request_id" ALIGN="LEFT"><FONT POINT-SIZE="9">request_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_actor_id" ALIGN="LEFT"><FONT POINT-SIZE="9">actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_permission_code" ALIGN="LEFT"><FONT POINT-SIZE="9">permission_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_operation_code" ALIGN="LEFT"><FONT POINT-SIZE="9">operation_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_scope_type" ALIGN="LEFT"><FONT POINT-SIZE="9">scope_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_scope_id" ALIGN="LEFT"><FONT POINT-SIZE="9">scope_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_resource_type" ALIGN="LEFT"><FONT POINT-SIZE="9">resource_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_resource_id" ALIGN="LEFT"><FONT POINT-SIZE="9">resource_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_outcome" ALIGN="LEFT"><FONT POINT-SIZE="9">outcome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reason" ALIGN="LEFT"><FONT POINT-SIZE="9">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_ip_address" ALIGN="LEFT"><FONT POINT-SIZE="9">ip_address</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="authorization_audits"];
    n_identity_account_recovery_cases [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#DCEBFF" COLSPAN="3"><B>identity_account_recovery_cases</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_public_id" ALIGN="LEFT"><FONT POINT-SIZE="9">public_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(96)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_account_id" ALIGN="LEFT"><FONT POINT-SIZE="9">account_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_target_email_normalized" ALIGN="LEFT"><FONT POINT-SIZE="9">target_email_normalized</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(320)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_challenge_id" ALIGN="LEFT"><FONT POINT-SIZE="9">challenge_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD><TD PORT="p_created_by" ALIGN="LEFT"><FONT POINT-SIZE="9">created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_proof_reference" ALIGN="LEFT"><FONT POINT-SIZE="9">proof_reference</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(24)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_expires_at" ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_completed_at" ALIGN="LEFT"><FONT POINT-SIZE="9">completed_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_cancelled_at" ALIGN="LEFT"><FONT POINT-SIZE="9">cancelled_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="identity_account_recovery_cases"];
