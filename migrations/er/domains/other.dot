    n_platform_operation_runs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>platform_operation_runs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(96)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_kind" ALIGN="LEFT"><FONT POINT-SIZE="9">kind</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_subject_type" ALIGN="LEFT"><FONT POINT-SIZE="9">subject_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_subject_id" ALIGN="LEFT"><FONT POINT-SIZE="9">subject_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(24)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_actor_id" ALIGN="LEFT"><FONT POINT-SIZE="9">actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_idempotency_key" ALIGN="LEFT"><FONT POINT-SIZE="9">idempotency_key</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_details" ALIGN="LEFT"><FONT POINT-SIZE="9">details</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_error_message" ALIGN="LEFT"><FONT POINT-SIZE="9">error_message</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</F