    n_platform_outbox [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>platform_outbox</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_event_type" ALIGN="LEFT"><FONT POINT-SIZE="9">event_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_schema_version" ALIGN="LEFT"><FONT POINT-SIZE="9">schema_version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_aggregate_type" ALIGN="LEFT"><FONT POINT-SIZE="9">aggregate_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_aggregate_id" ALIGN="LEFT"><FONT POINT-SIZE="9">aggregate_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_payload" ALIGN="LEFT"><FONT POINT-SIZE="9">payload</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_headers" ALIGN="LEFT"><FONT POINT-SIZE="9">headers</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_idempotency_key" ALIGN="LEFT"><FONT POINT-SIZE="9">idempotency_key</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PO