digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — Other", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_Other {
    label="Other"; color="#F3F3F3"; penwidth=2; style="rounded";
    n_content_moderation_actions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>content_moderation_actions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_case_id" ALIGN="LEFT"><FONT POINT-SIZE="9">case_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_id" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_action" ALIGN="LEFT"><FONT POINT-SIZE="9">action</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reason" ALIGN="LEFT"><FONT POINT-SIZE="9">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_actor_id" ALIGN="LEFT"><FONT POINT-SIZE="9">actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_before_state" ALIGN="LEFT"><FONT POINT-SIZE="9">before_state</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(96)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_after_state" ALIGN="LEFT"><FONT POINT-SIZE="9">after_state</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(96)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="content_moderation_actions"];
    n_content_moderation_cases [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>content_moderation_cases</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_id" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reason" ALIGN="LEFT"><FONT POINT-SIZE="9">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_opened_by" ALIGN="LEFT"><FONT POINT-SIZE="9">opened_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_resolved_by" ALIGN="LEFT"><FONT POINT-SIZE="9">resolved_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_opened_at" ALIGN="LEFT"><FONT POINT-SIZE="9">opened_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_resolved_at" ALIGN="LEFT"><FONT POINT-SIZE="9">resolved_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="content_moderation_cases"];
    n_content_revisions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>content_revisions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_id" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_title" ALIGN="LEFT"><FONT POINT-SIZE="9">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_content" ALIGN="LEFT"><FONT POINT-SIZE="9">content</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_content_format" ALIGN="LEFT"><FONT POINT-SIZE="9">content_format</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_tags" ALIGN="LEFT"><FONT POINT-SIZE="9">tags</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_action" ALIGN="LEFT"><FONT POINT-SIZE="9">action</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_reason" ALIGN="LEFT"><FONT POINT-SIZE="9">reason</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_created_by" ALIGN="LEFT"><FONT POINT-SIZE="9">created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="content_revisions"];
    n_permissions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_role_id" ALIGN="LEFT"><FONT POINT-SIZE="9">role_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_resource" ALIGN="LEFT"><FONT POINT-SIZE="9">resource</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_action" ALIGN="LEFT"><FONT POINT-SIZE="9">action</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="permissions"];
    n_platform_command_audits [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F3F3F3" COLSPAN="3"><B>platform_command_audits</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_command_id" ALIGN="LEFT"><FONT POINT-SIZE="9">command_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_command_code" ALIGN="LEFT"><FONT POINT-SIZE="9">command_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_actor_id" ALIGN="LEFT"><FONT POINT-SIZE="9">actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_actor_type" ALIGN="LEFT"><FONT POINT-SIZE="9">actor_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_resource_type" ALIGN="LEFT"><FONT POINT-SIZE="9">resource_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_resource_id" ALIGN="LEFT"><FONT POINT-SIZE="9">resource_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_operation_code" ALIGN="LEFT"><FONT POINT-SIZE="9">operation_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_permission_code" ALIGN="LEFT"><FONT POINT-SIZE="9">permission_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_request_id" ALIGN="LEFT"><FONT POINT-SIZE="9">request_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD