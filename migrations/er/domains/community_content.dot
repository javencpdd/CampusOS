digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — Community &amp; Content", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_Community___Content {
    label="Community &amp; Content"; color="#E3F4E8"; penwidth=2; style="rounded";
    n_categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E3F4E8" COLSPAN="3"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_name" ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_slug" ALIGN="LEFT"><FONT POINT-SIZE="9">slug</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_description" ALIGN="LEFT"><FONT POINT-SIZE="9">description</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_icon" ALIGN="LEFT"><FONT POINT-SIZE="9">icon</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD><TD PORT="p_parent_id" ALIGN="LEFT"><FONT POINT-SIZE="9">parent_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sort_order" ALIGN="LEFT"><FONT POINT-SIZE="9">sort_order</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_count" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_count</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_post_count" ALIGN="LEFT"><FONT POINT-SIZE="9">post_count</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_is_closed" ALIGN="LEFT"><FONT POINT-SIZE="9">is_closed</FONT></TD><TD ALIGN="LEFT"><FONT 