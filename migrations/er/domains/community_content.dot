    n_category_thread_type_policies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#E3F4E8" COLSPAN="3"><B>category_thread_type_policies</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK FK NN</FONT></TD><TD PORT="p_category_id" ALIGN="LEFT"><FONT POINT-SIZE="9">category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK NN</FONT></TD><TD PORT="p_thread_type" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_enabled" ALIGN="LEFT"><FONT POINT-SIZE="9">enabled</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="category_thread_type_policies"];
