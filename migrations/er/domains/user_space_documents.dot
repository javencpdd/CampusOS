digraph CampusOS_ER {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0",
         splines=polyline, overlap=false, compound=true, concentrate=false,
         labelloc="t", label="CampusOS v1 — User Space &amp; Documents", fontsize=20, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=8, color="#667085", arrowsize=0.7];
  subgraph cluster_User_Space___Documents {
    label="User Space &amp; Documents"; color="#EEE5FF"; penwidth=2; style="rounded";
    n_personal_document_previews [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>personal_document_previews</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ NN</FONT></TD><TD PORT="p_document_version_id" ALIGN="LEFT"><FONT POINT-SIZE="9">document_version_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_preview_object_id" ALIGN="LEFT"><FONT POINT-SIZE="9">preview_object_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_error_code" ALIGN="LEFT"><FONT POINT-SIZE="9">error_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_attempts" ALIGN="LEFT"><FONT POINT-SIZE="9">attempts</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, tooltip="personal_document_previews"];
    n_personal_document_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>personal_document_versions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_document_id" ALIGN="LEFT"><FONT POINT-SIZE="9">document_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version_number" ALIGN="LEFT"><FONT POINT-SIZE="9">version_number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_source_object_id" ALIGN="LEFT"><FONT POINT-SIZE="9">source_object_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_source_type" ALIGN="LEFT"><FONT POINT-SIZE="9">source_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_size_bytes" ALIGN="LEFT"><FONT POINT-SIZE="9">size_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sha256" ALIGN="LEFT"><FONT POINT-SIZE="9">sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_restored_from_version_id" ALIGN="LEFT"><FONT POINT-SIZE="9">restored_from_version_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_by" ALIGN="LEFT"><FONT POINT-SIZE="9">created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, tooltip="personal_document_versions"];
    n_personal_documents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>personal_documents</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_owner_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">owner_user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_name" ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_document_type" ALIGN="LEFT"><FONT POINT-SIZE="9">document_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK</FONT></TD><TD PORT="p_current_version_id" ALIGN="LEFT"><FONT POINT-SIZE="9">current_version_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD></TR></TABLE>>, tooltip="personal_documents"];
    n_user_space_contents [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>user_space_contents</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_id" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_title" ALIGN="LEFT"><FONT POINT-SIZE="9">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_excerpt" ALIGN="LEFT"><FONT POINT-SIZE="9">excerpt</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_author_name" ALIGN="LEFT"><FONT POINT-SIZE="9">author_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_category_id" ALIGN="LEFT"><FONT POINT-SIZE="9">category_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_tags" ALIGN="LEFT"><FONT POINT-SIZE="9">tags</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_status" ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_thread_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">thread_updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_synced_at" ALIGN="LEFT"><FONT POINT-SIZE="9">synced_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_space_contents"];
    n_user_space_style_snapshots [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>user_space_style_snapshots</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_snapshot_type" ALIGN="LEFT"><FONT POINT-SIZE="9">snapshot_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_style_name" ALIGN="LEFT"><FONT POINT-SIZE="9">style_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_style_version" ALIGN="LEFT"><FONT POINT-SIZE="9">style_version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_theme" ALIGN="LEFT"><FONT POINT-SIZE="9">theme</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_layout" ALIGN="LEFT"><FONT POINT-SIZE="9">layout</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_style_manifest" ALIGN="LEFT"><FONT POINT-SIZE="9">style_manifest</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_space_style_snapshots"];
    n_user_spaces [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#EEE5FF" COLSPAN="3"><B>user_spaces</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">FK NN</FONT></TD><TD PORT="p_user_id" ALIGN="LEFT"><FONT POINT-SIZE="9">user_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_title" ALIGN="LEFT"><FONT POINT-SIZE="9">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_bio" ALIGN="LEFT"><FONT POINT-SIZE="9">bio</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_avatar" ALIGN="LEFT"><FONT POINT-SIZE="9">avatar</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_cover_image" ALIGN="LEFT"><FONT POINT-SIZE="9">cover_image</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(512)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_theme" ALIGN="LEFT"><FONT POINT-SIZE="9">theme</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_layout" ALIGN="LEFT"><FONT POINT-SIZE="9">layout</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_visibility" ALIGN="LEFT"><FONT POINT-SIZE="9">visibility</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sync_enabled" ALIGN="LEFT"><FONT POINT-SIZE="9">sync_enabled</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sync_categories" ALIGN="LEFT"><FONT POINT-SIZE="9">sync_categories</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_sync_tags" ALIGN="LEFT"><FONT POINT-SIZE="9">sync_tags</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT[]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_updated_at" ALIGN="LEFT"><FONT POINT-SIZE="9">updated_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT"></TD><TD PORT="p_deleted_at" ALIGN="LEFT"><FONT POINT-SIZE="9">deleted_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="user_spaces"];
  }
  subgraph cluster_external {
    label="External references"; color="#DDDDDD"; style="dashed,rounded";
    n_users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#F7F7F7" COLSPAN="3"><B>users</B></TD></TR></TABLE>>, tooltip="users"];
  }
  n_personal_document_versions:p_id:e -> n_personal_documents:p_current_version_id:w [dir=both, arrowtail=tee, arrowhead=crow, label="1 : 0..N · DEL RESTRICT", tooltip="fk_personal_documents_current_version: personal_documents(current_version_id) → personal_document_versions(id)"];
  n_users:p_id:e -> n_user_space_contents:p_user_id:w [dir=both, arrowtail=tee, arrowhead=crow, label="1 : N · DEL RESTRICT", tooltip="fk_user_space_contents_user: user_space_contents(user_id) → users(id)"];
  n_users:p_id:e -> n_user_spaces:p_user_id:w [dir=both, arrowtail=tee, arrowhead=crow, label="1 : N · DEL RESTRICT", tooltip="fk_user_spaces_user: user_spaces(user_id) → users(id)"];
}