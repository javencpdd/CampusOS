    n_plugin_releases [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#FFE1E7" COLSPAN="3"><B>plugin_releases</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">PK</FONT></TD><TD PORT="p_id" ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_plugin_name" ALIGN="LEFT"><FONT POINT-SIZE="9">plugin_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_version" ALIGN="LEFT"><FONT POINT-SIZE="9">version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_checksum" ALIGN="LEFT"><FONT POINT-SIZE="9">checksum</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(128)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_signature_state" ALIGN="LEFT"><FONT POINT-SIZE="9">signature_state</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_channel" ALIGN="LEFT"><FONT POINT-SIZE="9">channel</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_rollout_state" ALIGN="LEFT"><FONT POINT-SIZE="9">rollout_state</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD><TD PORT="p_created_at" ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>, tooltip="plugin_releases"];
